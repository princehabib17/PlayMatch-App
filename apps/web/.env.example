# Database (REQUIRED)
DATABASE_URL=postgresql://user:password@host:5432/database

# CORS Origins (optional - comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Auth Secret (required if using authentication)
AUTH_SECRET=your-secret-key-here

# Create.xyz Integration (if using)
NEXT_PUBLIC_CREATE_BASE_URL=https://www.create.xyz
NEXT_PUBLIC_CREATE_HOST=your-host.com
NEXT_PUBLIC_PROJECT_GROUP_ID=your-project-id
