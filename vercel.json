{
  "buildCommand": "cd apps/mobile && npm install && npx expo export:web",
  "outputDirectory": "apps/mobile/dist",
  "installCommand": "cd apps/mobile && npm install",
  "framework": null,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "EXPO_PUBLIC_API_BASE_URL": "https://play-match-app.vercel.app"
  }
}
